[{"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0001", "text": "和名をハダカカメガイといい、実は巻き貝の一種とされている、その姿から「流氷の天使」と呼ばれる動物は何でしょう?", "grades": {"3777755": 1, "1099066": 1, "1864632": 1, "1198706": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0051", "text": "フラーレン、黒鉛、ダイヤモンドといえばいずれもどんな元素から出来ている物質でしょう?", "grades": {"57678": 1, "4029520": 1, "3555136": 1, "11533": 1, "57685": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0077", "text": "縁結びの神とされる大国主が祭られており、毎年旧暦10月に全国の神様が集まるとされる島根県の神社はどこでしょう?", "grades": {"4316005": 1, "4322391": 1, "2464486": 1, "4289468": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0150", "text": "日本語では「精神感応」などと呼ばれる、離れている相手に思考や感情などを伝える超能力は何でしょう?", "grades": {"180574": 1, "1299510": 1, "1015955": 1, "2835783": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0172", "text": "タバコの三大有害物質といえば、ニコチン、タールと何でしょう?", "grades": {"2226929": 1, "4501299": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0288", "text": "座った状態で鞘から刀を抜き、鞘に納めるまでを一連の流れとする、日本の武道は何でしょう?", "grades": {"378571": 1, "234631": 1, "378570": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0359", "text": "かつて新聞が1部4ページだった頃に、3ページ目が社会面だったことに由来する、社会の一般的な事件を取り扱った記事を指す言葉は何でしょう?", "grades": {"2732804": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0505", "text": "ギリシャ文字で、アルファ、ベータに次ぐ3番目の文字は何でしょう?", "grades": {"391398": 1, "4067462": 1, "103045": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0519", "text": "考案したノルウェーのスケート選手の名がつけられた、フィギュアスケートの6種類のジャンプのうち、他のジャンプよりも半回転多く回るものを何というでしょう?", "grades": {"2036986": 1, "2036988": 1, "2036987": 1, "2037647": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0605", "text": "アイドルグループ・欅坂46のデビュー曲のタイトルにもなっている、「物言わぬ多数派」という意味がある英語は何でしょう?", "grades": {"3636278": 1, "4408162": 1, "1630422": 1, "1630418": 1, "1630419": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0609", "text": "女声の音域で、ソプラノとアルトの中間にあたるものを何というでしょう?", "grades": {"980661": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0629", "text": "主な著作に『帝室論』『西洋事情』『学問のすゝめ』などがある明治時代の教育者は誰でしょう?", "grades": {"502485": 1, "4285231": 1, "4285230": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0705", "text": "「モンキー乗り」といえば競馬の用語ですが、「モンキーターン」といえばどんな公営ギャンブルの用語でしょう?", "grades": {"2221845": 1, "72596": 1, "231122": 1, "1223399": 1, "2221843": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0725", "text": "ファッションショーでモデルが歩く通路のことを、英語で何というでしょう?", "grades": {"4666315": 1, "3417211": 1, "3417210": 1, "1258789": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0743", "text": "童謡『サッちゃん』でサッちゃんの大好きな食べ物は何でしょう?", "grades": {"400977": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0832", "text": "乾燥させたイナゴ豆1粒の重さを由来とし、現在では0.2グラムを1とする、宝石の重さを示す単位は何でしょう?", "grades": {"76667": 1, "76666": 1, "76668": 1, "2421967": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0857", "text": "約4.6万平方メートルと広い面積を持つため、よく広大な面積の比喩として「これ何個分」などと例えられる、プロ野球・読売ジャイアンツの本拠地にもなっているドーム球場とはどこでしょう?", "grades": {"119853": 1, "1912046": 1, "119871": 1, "119851": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0878", "text": "1994年からの11年間、『週刊こどもニュース』のお父さん役を務めたことでも知られる、「いい質問ですね」のセリフでおなじみのジャーナリストは誰でしょう?", "grades": {"498645": 1, "231273": 1, "379021": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0908", "text": "代表作に「自衛隊三部作」「三匹のおっさんシリーズ」「図書館戦争シリーズ」がある、人気作家は誰でしょう?", "grades": {"1547202": 1, "1547195": 1, "2345747": 1, "2715232": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20CAPR-0966", "text": "長男の裕哉も歌手として活躍している、『卒業』や『I LOVE YOU』といった楽曲のヒットにより80年代にカリスマ的な人気を博したミュージシャンは誰でしょう?", "grades": {"1236901": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0043", "text": "現在の台長を常田佐久が務める、東京都三鷹市に本部を置く天文に関する研究施設は何?", "grades": {"566050": 1, "4598715": 1, "566042": 1, "566044": 1, "1128681": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0059", "text": "フランス料理で、肉や魚を焼く途中にブランデーなどをふりかけ、大きく炎をあげて香りをつける料理技法を何という?", "grades": {"151099": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0090", "text": "アメリカの短編文学賞にその名がつけられている、代表作『賢者の贈りもの』『最後の一葉』で知られる作家は誰?", "grades": {"4156496": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0203", "text": "アフリカの国・ボツワナ共和国の面積のおよそ7割を占める、アフリカ大陸南部に広がる砂漠は何?", "grades": {"2924179": 1, "58170": 1, "1301332": 1, "199033": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0241", "text": "1967年に出版された、赤ちゃんをあやす遊びを題名にした、松谷みよ子の絵本は何?", "grades": {"186585": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0245", "text": "イタリア語で「焼いた土」という意味がある、陶器や建築部材などに用いられる粘土を何という?", "grades": {"486861": 1, "886472": 1, "886470": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0453", "text": "平安時代後期に急増した、盗賊などから寺を守るために武装した僧侶のことを何という?", "grades": {"443062": 1, "443059": 1, "1505832": 1, "443061": 1, "443060": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0487", "text": "東京都の千代田区と台東区にまたがる地域で、電気屋街があることや、「サブカルチャーの聖地」として有名なのはどこ?", "grades": {"65316": 1, "2707965": 1, "2707955": 1, "2707952": 1, "448564": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0490", "text": "プレゼントとして母の日に子どもから母親に贈られる、和名を「オランダセキチク」というナデシコ科の花は何?", "grades": {"1514667": 1, "892801": 1, "1514665": 1, "623281": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0552", "text": "ゼウスが最高神であるのはギリシャ神話ですが、ユピテルが最高神であるのは何神話?", "grades": {"954445": 1, "51424": 1, "51446": 1, "51449": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0610", "text": "こと座のベガ、わし座 のアルタイル、はくちょう座のデネブを結んでできる三角形を、見える季節から何という?", "grades": {"589512": 1, "486608": 1, "1095408": 1, "734046": 1, "1095410": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0616", "text": "熱帯原産といわれるマメの一種で、煮崩れしにくいところから、アズキの代わりに赤飯に用いられるのは何?", "grades": {"225068": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0643", "text": "おうし座には2つの散開星団があります。「すばる」として知られるプレアデス星団と、もうひとつは何?", "grades": {"959874": 1, "4579762": 1, "4579668": 1, "4579667": 1, "2927512": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0696", "text": "小倉百人一首の第一首「秋の田の かりほの庵の 苫を粗み わが衣手は 露に濡れつつ」を詠んだ天皇は誰?", "grades": {"434946": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0697", "text": "横向きになって胸を強調する「サイドチェスト」などのポーズで、鍛え上げた筋肉を審査する競技は何?", "grades": {"1521584": 1, "1521586": 1, "880352": 1, "1521587": 1, "1459467": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0762", "text": "インドの初代首相ネルーの一人娘で、1966年に同国の首相となったのは誰?", "grades": {"644943": 1, "3272582": 1, "644942": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0817", "text": "巨人の応援歌『闘魂こめて』、阪神の応援歌『六甲おろし』を手がけた作曲家は誰?", "grades": {"378509": 1, "313985": 1, "5339587": 1, "378517": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0869", "text": "兵庫県明石近辺の郷土料理「くぎ煮」とは、何という魚の幼魚を使った佃煮?", "grades": {"5420630": 1, "5420629": 1, "858457": 1, "858459": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0893", "text": "1890年に日本初の電動エレベーターが設置された、かつて東京・浅草にあったが、関東大震災で半壊し、撤去された高層建築物は何?", "grades": {"1039611": 1, "29615": 1, "125829": 1, "1039613": 1}}, {"subset": "jqara-dev-s40", "kb": "jqara-k60", "id": "QA20QBIK-0903", "text": "ミソハギ科の落葉高木で、木の枝がつるつるしていて滑りやすいことからその名がついたものは何?", "grades": {"990043": 1, "990041": 1}}, {"subset": "miracl-ja-dev-s30", "kb": "miracl-k60", "id": "1015", "text": "スイス連邦の首都はどこ？", "grades": {"d83b66f2f9fbf166210615cb85744ebf4b519df8cf5d67bb865c1edbf9ba5a3e0": 1}}, {"subset": "miracl-ja-dev-s30", "kb": "miracl-k60", "id": "1163", "text": "情報番組の起源はいつ", "grades": {"da855d48763f6b41c6dd3e6495e82e95b26bc7113cd8539ce32c6da15a1694091": 1, "db998464fe701de1a44834cae9077c1bf8dfbd0cd604c236035b2f342719a2d02": 1}}, {"subset": "miracl-ja-dev-s30", "kb":